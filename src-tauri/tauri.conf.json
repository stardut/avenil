{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avenil",
  "version": "0.1.0",
  "identifier": "com.rundock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Avenil",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "A quiet place for things to run.",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
